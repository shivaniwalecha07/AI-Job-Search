# ---- Copy to .env and fill in. NEVER commit .env. ----

# Database (Postgres + pgvector)
DATABASE_URL=postgresql+psycopg://jobagent:jobagent@localhost:5432/jobagent

# LLM provider: anthropic | bedrock | openai  (only anthropic implemented in v1)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-5
LLM_EMBED_MODEL=voyage-3            # embeddings provider is pluggable; placeholder

# Discovery
TARGET_ROLES_CONFIG=config/sources.yaml
PROFILE_CONFIG=config/profile.yaml
RANKING_CONFIG=config/ranking.yaml

# Freshness / anti-spam
RECENT_WINDOW_DAYS=3
DAILY_JOB_LIMIT=200
PER_COMPANY_COOLDOWN_HOURS=24

# Email digest (SMTP). For Gmail use an App Password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
DIGEST_FROM=you@example.com
DIGEST_TO=you@example.com

# Runtime
LOG_LEVEL=INFO
TIMEZONE=America/Phoenix
